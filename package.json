{
  "name": "orbit-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm api:generate && vite",
    "build": "pnpm api:generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm api:generate && tsc -b",
    "lint": "pnpm api:generate && eslint . --max-warnings 0",
    "lint:fix": "pnpm api:generate && eslint . --fix",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm api:generate && vitest run",
    "test:watch": "pnpm api:generate && vitest",
    "test:e2e": "pnpm api:generate && playwright test",
    "test:e2e:cross-browser": "pnpm api:generate && playwright test --config playwright.cross-browser.config.ts --project=chromium --project=webkit",
    "api:generate": "openapi-ts",
    "api:pull": "node scripts/pull-openapi.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:fsd && pnpm format:check && pnpm test",
    "test:e2e:pwa": "pnpm api:generate && playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@matrix-org/olm": "^3.2.15",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.4",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "steiger": "^0.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0"
}
